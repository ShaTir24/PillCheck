# Local dev (docker-compose Postgres) — direct connection, normal pooling
DATABASE_URL=postgresql+asyncpg://pillcheck:pillcheck@localhost:5433/pillcheck

# Supabase (staging/prod) — Supavisor transaction pooler, port 6543.
# Get this from Supabase project settings -> Database -> Connection string -> "Transaction" mode.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Set true only when DATABASE_URL points at the Supabase pooler (port 6543).
# Forces NullPool + disables asyncpg statement caching, required for transaction-mode pooling (ADR-002).
DB_USE_TRANSACTION_POOLER=false

# In-house auth (see app/core/security.py, ADR-006). Required — generate with
# `openssl rand -hex 32`. Never commit a real value.
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# Comma-separated. Only matters for Expo web (native app calls aren't subject to CORS).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
